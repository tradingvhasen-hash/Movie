# ── Dhawq environment ────────────────────────────────────────────
# The app runs fully WITHOUT any of these (local demo mode).
# Add them as you activate cloud features.

# Supabase (supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never expose): used by scripts/seed.ts
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# TMDB (themoviedb.org → Settings → API) — used by scripts/seed.ts
TMDB_API_KEY=
